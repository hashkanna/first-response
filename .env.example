# Credentials stay in the backend. Never use VITE_ for secrets.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_INVESTIGATOR_MODEL=gemini-3.8-flash

# local = no provider credentials required; gemini = real Pydantic AI analysis.
INVESTIGATOR_BACKEND=local
# authored = offline fixtures; gemini = model-generated edits, requires Modal.
REPAIR_BACKEND=authored
GEMINI_REPAIR_MODEL=gemini-3.8-flash
# local = trusted authored code in subprocesses; modal = network-disabled cloud sandboxes.
VERIFICATION_BACKEND=local

# Opt in only when using the temporary localhost credential setup form.
WAR_ROOM_ENABLE_SETUP=0
GEMINI_LIVE_MAX_SECONDS=900
